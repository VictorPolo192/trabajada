# Copia este archivo como .env.local y rellena los valores. NUNCA subas .env.local al repositorio.
# Supabase > Project Settings > API Keys

# URL del proyecto (https://<ref>.supabase.co). Solo la usa el servidor.
SUPABASE_URL=

# Clave SECRETA (sb_secret_...) o, en proyectos antiguos, la service_role.
# Salta RLS: solo se usa en las rutas /api/supabase/* del servidor.
# ¡Sin prefijo NEXT_PUBLIC_! Con ese prefijo Next.js la incluiría en el JavaScript del navegador.
SUPABASE_SECRET_KEY=

# Opcionales: si no se define SUPABASE_URL se usa NEXT_PUBLIC_SUPABASE_URL.
# La clave publicable solo se usa como respaldo de lectura (con RLS sin políticas, no verá filas).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
